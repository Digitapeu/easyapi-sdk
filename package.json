{
  "name": "@easyapi/sdk",
  "version": "0.1.0",
  "description": "Server-side TypeScript SDK and CLI for the easyapi Romanian government services API, with DPoP-bound machine authentication.",
  "license": "MIT",
  "author": "Daniel Tamas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "easyapi": {
    "defaultBaseUrl": "https://easyapi.ro"
  },
  "bin": {
    "easyapi": "./dist/esm/src/cli/bin.js"
  },
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "gen:types": "openapi-typescript contract/openapi.json -o src/generated/openapi.ts",
    "gen:defaults": "node scripts/gen-defaults.mjs",
    "build": "node scripts/gen-defaults.mjs && rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "e2e:node": "node scripts/e2e-node.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.17",
    "@types/node": "24.19.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
