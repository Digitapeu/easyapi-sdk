{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node",
      "bun"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@easyapi/sdk": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "contract",
    "test",
    "examples"
  ]
}
